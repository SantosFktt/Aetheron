profile.LOW=Low (Performance)
profile.MEDIUM=Medium (Balanced)
profile.ULTRA=Ultra (RTX Next-Gen)
profile.comment=Select an overall quality preset. Low maximizes framerate, Medium balances quality & performance, and Ultra unleashes full volumetric clouds, 4K PCSS shadows, SSIL indirect lighting, and premium water reflections (designed for RTX 5070 / high-end GPUs). Individual options can be tweaked freely after selecting a preset.

# Screens
screen.LIGHTING=Lighting & Materials
screen.SHADOWS=Shadows
screen.ATMOSPHERE=Atmosphere & Fog
screen.CLOUDS=Volumetric Clouds
screen.WATER=Water & Reflections
screen.VEGETATION=Vegetation & Wind
screen.POST_PROCESSING=Post-Processing & Color
screen.PERFORMANCE=Performance & Anti-Aliasing

# Lighting
option.SUN_INTENSITY=Sunlight Intensity
option.SUN_INTENSITY.comment=Controls direct solar luminance across the Overworld.
option.MOON_INTENSITY=Moonlight Intensity
option.MOON_INTENSITY.comment=Controls nocturnal illumination modulated by the current lunar phase.
option.AMBIENT_INTENSITY=Sky Ambient Intensity
option.AMBIENT_INTENSITY.comment=Adjusts indirect hemisphere sky fill lighting in shadowed areas.
option.BLOCKLIGHT_INTENSITY=Blocklight Intensity
option.BLOCKLIGHT_INTENSITY.comment=Controls brightness of torches, lanterns, lava, and artificial light sources.
option.BLOCKLIGHT_TEMP=Blocklight Warmth
option.BLOCKLIGHT_TEMP.comment=Shifts artificial light color temperature (lower = warmer candlelight, higher = neutral halogen).
option.EMISSIVE_INTENSITY=Emissive Glow
option.EMISSIVE_INTENSITY.comment=Controls luminance of glowing ores, lanterns, lava, sculk, froglights, and soul fire.
option.CAVE_BRIGHTNESS=Natural Cave Ambient
option.CAVE_BRIGHTNESS.comment=Minimum ambient light deep underground for realistic yet playable cave exploration.
option.SSIL_QUALITY=Screen-Space Indirect Lighting
option.SSIL_QUALITY.comment=Computes single-bounce screen-space colored diffuse global illumination.
value.SSIL_QUALITY.0=Off
value.SSIL_QUALITY.1=Balanced
value.SSIL_QUALITY.2=Ultra (Multi-Bounce Approx)
option.BIOME_LIGHTING=Biome-Aware Lighting
option.BIOME_LIGHTING.comment=Subtly adapts sunlight warmth, sky tint, and haze to deserts, cold peaks, swamps, and oceans.
option.WEATHER_PUDDLES=Rain Wetness & Puddles
option.WEATHER_PUDDLES.comment=Adds wet surface darkening and reflective rain puddles on exposed terrain during storms.

# Shadows
option.SHADOW_QUALITY=Shadow Filtering Quality
option.SHADOW_QUALITY.comment=Selects shadow filtering algorithm. Ultra uses variable-penumbra PCSS with Vogel disk sampling.
value.SHADOW_QUALITY.1=Low (Fast PCF)
value.SHADOW_QUALITY.2=Medium (Soft Vogel PCF)
value.SHADOW_QUALITY.3=Ultra (Variable Penumbra PCSS)
option.shadowMapResolution=Shadow Resolution
option.shadowMapResolution.comment=Resolution of the directional shadow map. Higher values deliver razor-sharp shadow edges.
value.shadowMapResolution.1024=1024 (Low)
value.shadowMapResolution.2048=2048 (Medium)
value.shadowMapResolution.3072=3072 (High)
value.shadowMapResolution.4096=4096 (Ultra)
option.shadowDistance=Shadow Distance
option.shadowDistance.comment=Maximum shadow casting range in blocks.
suffix.shadowDistance= blocks
option.SHADOW_SOFTNESS=Shadow Softness
option.SHADOW_SOFTNESS.comment=Scales the filter penumbra radius for directional shadows.
option.CONTACT_SHADOWS=Screen-Space Contact Shadows
option.CONTACT_SHADOWS.comment=Traces fine short-range screen-space rays to ground grass, small blocks, and overhangs where shadow maps lack resolution.
value.CONTACT_SHADOWS.0=Off
value.CONTACT_SHADOWS.1=On
option.COLORED_SHADOWS=Colored Translucent Shadows
option.COLORED_SHADOWS.comment=Stained glass and tinted translucent blocks cast colored light shafts.
option.FOLIAGE_SSS=Foliage Subsurface Scattering
option.FOLIAGE_SSS.comment=Simulates sunlight transmitting warmly through leaves, grass, and crops.

# Atmosphere & Fog
option.ATMOSPHERE_DENSITY=Atmospheric Scattering
option.ATMOSPHERE_DENSITY.comment=Controls Rayleigh & Mie scattering intensity in the sky and aerial perspective.
option.VOLUMETRIC_FOG_QUALITY=Volumetric Lighting Quality
option.VOLUMETRIC_FOG_QUALITY.comment=Controls raymarching quality for volumetric fog and crepuscular god rays.
value.VOLUMETRIC_FOG_QUALITY.0=Off
value.VOLUMETRIC_FOG_QUALITY.1=Low (Fast)
value.VOLUMETRIC_FOG_QUALITY.2=Medium (Balanced)
value.VOLUMETRIC_FOG_QUALITY.3=Ultra (High-Detail)
option.VOLUMETRIC_FOG_DENSITY=Volumetric Fog Density
option.VOLUMETRIC_FOG_DENSITY.comment=Controls volumetric light scattering density in the air. Keep balanced to preserve clear vistas.
option.HEIGHT_FOG_DENSITY=Height Valley Mist
option.HEIGHT_FOG_DENSITY.comment=Low-lying atmospheric mist gathering in valleys, rivers, and mornings.
option.DISTANCE_FOG_DENSITY=Atmospheric Perspective
option.DISTANCE_FOG_DENSITY.comment=Subtle aerial scattering that gives distant mountains realistic atmospheric depth.
option.GOD_RAYS=Crepuscular God Rays
option.GOD_RAYS.comment=Enables sunlight shafts streaming through trees, caves, and mountain silhouettes.
value.GOD_RAYS.0=Off
value.GOD_RAYS.1=On
option.GOD_RAY_STRENGTH=God Ray Intensity
option.GOD_RAY_STRENGTH.comment=Controls brightness of forward-scattered light shafts.
option.STAR_BRIGHTNESS=Starfield Brightness
option.STAR_BRIGHTNESS.comment=Adjusts visibility of multi-layer procedural stars and the Milky Way band at night.
option.MOON_SIZE=Moon Angular Scale
option.MOON_SIZE.comment=Adjusts the visual size of the shaded lunar disc.

# Clouds
option.CLOUD_QUALITY=Volumetric Cloud Quality
option.CLOUD_QUALITY.comment=Low uses fast analytic clouds; Medium uses optimized volumetric raymarching; Ultra uses multi-layer 3D volumetric raymarching with self-shadowing and powder scattering.
value.CLOUD_QUALITY.0=Off
value.CLOUD_QUALITY.1=Low (Analytic 2D Layer)
value.CLOUD_QUALITY.2=Medium (Volumetric)
value.CLOUD_QUALITY.3=Ultra (Multi-Layer 3D Volumetric)
option.CLOUD_COVERAGE=Cloud Coverage
option.CLOUD_COVERAGE.comment=Base fair-weather cloud coverage (weather storms dynamically increase coverage).
option.CLOUD_ALTITUDE=Cloud Altitude
option.CLOUD_ALTITUDE.comment=Base cloud deck height in world blocks.
suffix.CLOUD_ALTITUDE=m
option.CLOUD_THICKNESS=Cloud Thickness
option.CLOUD_THICKNESS.comment=Vertical thickness of cumulus cloud formations.
suffix.CLOUD_THICKNESS=m
option.CLOUD_SPEED=Cloud Wind Speed
option.CLOUD_SPEED.comment=Movement speed of drifting cloud formations.
option.CIRRUS_CLOUDS=High-Altitude Cirrus Layer
option.CIRRUS_CLOUDS.comment=Adds wispy upper-troposphere cirrus clouds that catch sunrise and sunset light.

# Water
option.WATER_QUALITY=Water Shading Quality
option.WATER_QUALITY.comment=Controls wave detail, spectral Beer-Lambert absorption, refraction, and underwater scattering.
value.WATER_QUALITY.1=Low (Lightweight Waves)
value.WATER_QUALITY.2=Medium (Detailed Waves + Refraction)
value.WATER_QUALITY.3=Ultra (Multi-Octave Waves + Full Optical Depth)
option.REFLECTION_QUALITY=Water Reflection Quality
option.REFLECTION_QUALITY.comment=Controls screen-space reflection (SSR) step count and binary search refinement.
value.REFLECTION_QUALITY.0=Sky Only
value.REFLECTION_QUALITY.1=Low (Fast SSR)
value.REFLECTION_QUALITY.2=Medium (Refined SSR)
value.REFLECTION_QUALITY.3=Ultra (High-Precision SSR + Sky/Cloud Fallback)
option.WATER_WAVE_HEIGHT=Wave Amplitude
option.WATER_WAVE_HEIGHT.comment=Controls surface wave normal steepness.
option.WATER_CLARITY=Water Clarity
option.WATER_CLARITY.comment=Higher values make water clearer and let you see deeper underwater.
option.WATER_CAUSTICS=Underwater Caustics
option.WATER_CAUSTICS.comment=Projects animated sunlit caustic patterns onto submerged terrain.
option.RAIN_RIPPLES=Rain Surface Ripples
option.RAIN_RIPPLES.comment=Adds animated concentric raindrop impacts on exposed water surfaces during rain.
option.UNDERWATER_FOG_DENSITY=Underwater Fog Density
option.UNDERWATER_FOG_DENSITY.comment=Controls underwater visibility and depth tinting when submerged.

# Vegetation
option.WAVING_FOLIAGE=Vegetation Wind Animation
option.WAVING_FOLIAGE.comment=Master switch for vertex wind simulation across vegetation.
value.WAVING_FOLIAGE.0=Off
value.WAVING_FOLIAGE.1=On
option.WIND_STRENGTH=Wind Strength
option.WIND_STRENGTH.comment=Amplitude of wind gusts (automatically intensifies during rain and storms).
option.WAVING_LEAVES=Waving Tree Leaves
option.WAVING_LEAVES.comment=Enables subtle wind flutter on tree canopies.
option.WAVING_GRASS=Waving Grass & Flowers
option.WAVING_GRASS.comment=Enables natural swaying motion on grass, ferns, and flowers.
option.WAVING_CROPS=Waving Crops & Vines
option.WAVING_CROPS.comment=Enables wind sway on farmland crops, sugarcane, vines, and underwater kelp.

# Post-Processing
option.TONEMAP_OPERATOR=Tonemapping Curve
option.TONEMAP_OPERATOR.comment=Selects HDR-to-SDR filmic display transform.
value.TONEMAP_OPERATOR.0=ACES Filmic (Cinematic)
value.TONEMAP_OPERATOR.1=AgX Neutral (Natural Highlights)
value.TONEMAP_OPERATOR.2=Aetheron Filmic (Photon x Bliss)
value.TONEMAP_OPERATOR.3=Uncharted 2 Filmic
option.EXPOSURE=Manual Exposure
option.EXPOSURE.comment=Overall scene exposure multiplier.
option.AUTO_EXPOSURE=Adaptive Auto-Exposure
option.AUTO_EXPOSURE.comment=Smoothly adapts eye exposure between bright outdoor sunlight and dark caves.
option.BLOOM_QUALITY=Bloom Quality
option.BLOOM_QUALITY.comment=Multi-scale Karis-weighted soft bloom around sun, specular glints, and emissive blocks.
value.BLOOM_QUALITY.0=Off
value.BLOOM_QUALITY.1=Fast (Single-Scale)
value.BLOOM_QUALITY.2=Premium (Dual-Scale Karis Bloom)
option.BLOOM_STRENGTH=Bloom Intensity
option.BLOOM_STRENGTH.comment=Controls subtle cinematic glow strength.
option.CONTRAST=Contrast
option.CONTRAST.comment=Fine-tunes filmic S-curve contrast.
option.SATURATION=Saturation
option.SATURATION.comment=Overall color saturation multiplier.
option.VIBRANCE=Vibrance
option.VIBRANCE.comment=Selectively enriches muted colors without oversaturating already vibrant tones.
option.COLOR_TEMP=Color Temperature
option.COLOR_TEMP.comment=Shifts overall white balance (negative = cooler, positive = warmer).
option.VIGNETTE_STRENGTH=Vignette
option.VIGNETTE_STRENGTH.comment=Subtle edge darkening for cinematic framing.
option.DOF_ENABLED=Depth of Field
option.DOF_ENABLED.comment=Optional cinematic Bokeh Depth of Field focused on the crosshair target.
value.DOF_ENABLED.0=Off
value.DOF_ENABLED.1=On
option.DOF_STRENGTH=Depth of Field Strength
option.DOF_STRENGTH.comment=Controls aperture blur radius when Depth of Field is enabled.
option.MOTION_BLUR_ENABLED=Camera Motion Blur
option.MOTION_BLUR_ENABLED.comment=Optional subtle velocity-based camera motion blur.
value.MOTION_BLUR_ENABLED.0=Off
value.MOTION_BLUR_ENABLED.1=On
option.MOTION_BLUR_STRENGTH=Motion Blur Strength
option.MOTION_BLUR_STRENGTH.comment=Controls shutter speed blur intensity.
option.CAS_SHARPENING=Contrast Adaptive Sharpening
option.CAS_SHARPENING.comment=AMD FidelityFX-style CAS sharpening to restore crisp texture detail after TAA.
value.CAS_SHARPENING.0=Off
value.CAS_SHARPENING.1=On
option.CAS_STRENGTH=Sharpening Strength
option.CAS_STRENGTH.comment=Controls CAS sharpening amount (avoid over-sharpening).

# Performance
option.AO_QUALITY=Ambient Occlusion Quality
option.AO_QUALITY.comment=Screen-space horizon ambient occlusion (GTAO-inspired) for grounded crevice shading.
value.AO_QUALITY.0=Off
value.AO_QUALITY.1=Low (Fast 4-Tap)
value.AO_QUALITY.2=Medium (Balanced 8-Tap)
value.AO_QUALITY.3=Ultra (Multi-Horizon 12-Tap)
option.AO_STRENGTH=Ambient Occlusion Strength
option.AO_STRENGTH.comment=Intensity of crevice contact darkening.
option.TAA_ENABLED=Temporal Anti-Aliasing (TAA)
option.TAA_ENABLED.comment=Eliminates foliage shimmer and geometric aliasing using YCoCg variance-clamped temporal reprojection.
value.TAA_ENABLED.0=Off
value.TAA_ENABLED.1=On
option.ADAPTIVE_RAYMARCHING=Adaptive Raymarching
option.ADAPTIVE_RAYMARCHING.comment=Enables early transmittance termination and step-size adaptation in clouds and volumetric fog for higher FPS.
option.DITHERING_ENABLED=Anti-Banding Dithering
option.DITHERING_ENABLED.comment=Applies triangular-PDF dithering to eliminate 8-bit sky and fog color banding.
